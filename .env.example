# Postgres connection for the app
DATABASE_URL=
# Postgres connection for integration tests (separate database)
DATABASE_URL_TEST=
# Auth.js secret (random 32+ bytes)
AUTH_SECRET=
# Public base URL of the app
APP_BASE_URL=
# Anthropic API key; leave empty to run the assistant in offline fallback mode
ANTHROPIC_API_KEY=
# Claude model id used by the assistant
ANTHROPIC_MODEL=
# Shared secret the cron caller sends as Bearer token
CRON_SECRET=
# HMAC secret for signed links and chat session cookies
LINK_SIGNING_SECRET=
# "true" to write outbound messages to the message log instead of sending
MOCK_MESSAGING=
