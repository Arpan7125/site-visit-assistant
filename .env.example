# Postgres connection for the app
DATABASE_URL=
# Direct (session) Postgres connection used by migrations; same as DATABASE_URL locally
DIRECT_URL=
# Postgres connection for integration tests (separate database)
DATABASE_URL_TEST=
# Auth.js secret (random 32+ bytes)
AUTH_SECRET=
# Public base URL of the app
APP_BASE_URL=
# Anthropic API key; leave empty to run the assistant in offline fallback mode
ANTHROPIC_API_KEY=
# Claude model id used by the assistant
ANTHROPIC_MODEL=
# Shared secret the cron caller sends as Bearer token
CRON_SECRET=
# HMAC secret for signed links and chat session cookies
LINK_SIGNING_SECRET=
# "true" to write outbound messages to the message log instead of sending
MOCK_MESSAGING=
# HMAC key used to hash phone numbers for duplicate lookup
PHONE_HASH_SECRET=
# Model vendor: "anthropic" or "gemini" (default: whichever key is set, Anthropic first)
AI_PROVIDER=
# Google Gemini API key (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=
# Gemini model id (default gemini-3.5-flash-lite) and thinking level (MINIMAL/LOW/MEDIUM/HIGH, or NONE)
GEMINI_MODEL=
GEMINI_THINKING=

# Max time (ms) the assistant may take before the fixed reply + handoff (default 20000)
AI_DEADLINE_MS=
# Comma-separated Gemini models tried in order when the primary is overloaded
GEMINI_FALLBACK_MODELS=
